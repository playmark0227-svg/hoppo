{
  "name": "hoppo-status",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "build": "esbuild client/firebase-entry.js --bundle --format=esm --minify --outfile=js/vendor/firebase.js",
    "test": "node --test tests/policy.test.cjs tests/store.test.cjs tests/auth.test.cjs",
    "test:rules": "firebase emulators:exec --project demo-hoppo --only firestore 'node --test tests/rules.test.cjs'",
    "test:integration": "firebase emulators:exec --project demo-hoppo --only auth,firestore,functions 'node --test tests/integration.test.cjs'"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "esbuild": "^0.28.2",
    "firebase": "^13.0.0",
    "firebase-tools": "^15.33.0",
    "playwright": "^1.64.0"
  }
}
